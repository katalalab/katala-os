#!/usr/bin/env bash
# Pre-commit drift guard for Katala OS repos. Opt-in per-repo via:
#   git config core.hooksPath ~/work/agent-context/hooks    # macOS / Linux
#   git config core.hooksPath "$env:USERPROFILE\work\agent-context\hooks"  # Windows (Git for Windows ships sh)
#
# Enforces: AGENTS.MD "Hard Rules" (no secrets in commits, no .env / *.key / *.pem
# / credentials.json / token.json / *.bak-* slipping through) plus JSON syntax
# validation for common config files.

set -euo pipefail

STAGED=$(git diff --cached --name-only --diff-filter=ACMR || true)
[ -z "$STAGED" ] && exit 0

FAIL=0

# 1. Block files that should never be committed.
BLOCK_FILES_RE='(^|/)(\.env(\..*)?$|.*\.key$|.*\.pem$|.*credentials\.json$|.*token\.json$|.*\.bak-[0-9]{8}-[0-9]{6}.*)'
BAD_FILES=$(echo "$STAGED" | grep -E "$BLOCK_FILES_RE" | grep -vE '\.env\.(example|template|sample)$' || true)
if [ -n "$BAD_FILES" ]; then
  echo "pre-commit: blocked sensitive / backup files:" >&2
  echo "$BAD_FILES" >&2
  echo "  -> If intentional, commit with --no-verify (records bypass in reflog)." >&2
  FAIL=1
fi

# 2. Block high-confidence secret patterns in staged content. Keep in sync with
#    the 'credential' scan in scripts/check-no-instance-data.sh — the commit-time
#    and publish-time gates cover the same set.
SECRET_RE='(sk-(ant|proj|live)-[A-Za-z0-9_-]{20,}|AIza[A-Za-z0-9_-]{30,}|(gho_|ghp_|ghr_|ghs_|github_pat_)[A-Za-z0-9_]{20,}|xox[abpsr]-[A-Za-z0-9-]{20,}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|npm_[A-Za-z0-9]{36}|eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}|[MN][A-Za-z0-9_-]{23,}\.[A-Za-z0-9_-]{6}\.[A-Za-z0-9_-]{27,}|discord(app)?\.com/api/webhooks/[0-9]+/[A-Za-z0-9_-]{20,}|hooks\.slack\.com/services/[A-Za-z0-9]+/[A-Za-z0-9]+/[A-Za-z0-9]{20,}|(mongodb(\+srv)?|postgres(ql)?|mysql|redis|amqp|mssql)://[^:/@[:space:]]+:[^@[:space:]]+@|aws_secret_access_key[[:space:]]*[:=][[:space:]]*.?[A-Za-z0-9/+=]{40}|"type"[[:space:]]*:[[:space:]]*"service_account")'
SECRET_HITS=$(git diff --cached --no-color -U0 | grep -cE "$SECRET_RE" || true)
if [ "${SECRET_HITS:-0}" -gt 0 ]; then
  # Count, not content. Echoing the match puts the secret in terminal scrollback and
  # in whatever session log the agent driving the commit is writing — a second copy
  # in a place nobody thinks to clean.
  echo "pre-commit: blocked $SECRET_HITS likely secret(s) in staged content." >&2
  echo "  -> Find them with: git diff --cached | grep -nE \"\$SECRET_RE\"  (see this hook for the pattern)" >&2
  echo "  -> Move the secret to 1Password (op://...) and reference it at runtime." >&2
  FAIL=1
fi

# 3. JSON syntax validation for staged .mcp.json / settings.json / package.json.
for f in $STAGED; do
  case "$f" in
    *.mcp.json|*/settings.json|package.json|*.claude-plugin/marketplace.json|*.claude-plugin/plugin.json)
      [ -f "$f" ] || continue
      if command -v jq >/dev/null 2>&1; then
        if ! jq empty "$f" >/dev/null 2>&1; then
          echo "pre-commit: invalid JSON: $f" >&2
          FAIL=1
        fi
      elif command -v python3 >/dev/null 2>&1; then
        if ! python3 -c "import json,sys; json.load(open(sys.argv[1], encoding='utf-8'))" "$f" >/dev/null 2>&1; then
          echo "pre-commit: invalid JSON: $f" >&2
          FAIL=1
        fi
      fi
      ;;
  esac
done

exit $FAIL
